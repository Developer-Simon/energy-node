{
  "title": "Energy automation rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "settings", "rules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tick_interval_s": { "type": "number", "minimum": 5, "maximum": 3600, "default": 10 },
        "settling_seconds": { "type": "number", "minimum": 0, "maximum": 3600, "default": 60 },
        "balance_max_age_s": { "type": "number", "minimum": 1, "maximum": 3600, "default": 30 },
        "publish_allowed_prefixes": { "type": "array", "items": { "type": "string" }, "default": [] },
        "history_limit": { "type": "number", "minimum": 1, "maximum": 200, "default": 10 },
        "history_persist": { "type": "boolean", "default": true },
        "publish_allowed_prefixes_auto": { "type": "boolean", "default": false },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90, "description": "Latitude of the site for sun_window, only together with longitude" },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180, "description": "Longitude of the site for sun_window, only together with latitude" }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "enabled", "conditions", "actions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "history_enabled": { "type": "boolean", "default": false },
          "cooldown_seconds": { "type": "number", "minimum": 0, "maximum": 86400, "default": 0 },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type"],
              "properties": {
                "type": { "type": "string", "enum": ["balance_threshold", "topic_value", "time_window", "entity_value", "sun_window"] },
                "field": { "type": "string", "pattern": "^(grid_export|grid_import|pv|load_total|base|wallbox|heat_pump|battery_charge|battery_discharge|gap_applied|autarkie|eigenverbrauch|battery_soc|battery_capacity_kwh|battery_energy_kwh|custom:[a-z0-9_]+)$" },
                "comparison": { "type": "string", "enum": ["above", "below", "equals", "not_equals"] },
                "threshold": { "type": "number" },
                "hysteresis": { "type": "number", "minimum": 0, "default": 0 },
                "hold_seconds": { "type": "number", "minimum": 0, "maximum": 86400, "default": 0 },
                "topic": { "type": "string", "format": "mqtt-topic", "x-dataflow": {"direction": "input", "label": "Condition topic", "json_key_field": "json_key"}, "x-dataflow-label-key": "dataflow.automation_rules.condition_topic" },
                "json_key": { "type": "string", "format": "mqtt-json-key" },
                "entity_id": { "type": "string" },
                "value_template": { "type": "string" },
                "value": { "type": "number" },
                "text": { "type": "string" },
                "start": { "type": "string" },
                "end": { "type": "string" },
                "from": { "type": "string", "enum": ["sunrise", "sunset"] },
                "to": { "type": "string", "enum": ["sunrise", "sunset"] },
                "from_offset_min": { "type": "integer", "minimum": -240, "maximum": 240, "default": 0 },
                "to_offset_min": { "type": "integer", "minimum": -240, "maximum": 240, "default": 0 },
                "weekdays": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "description": "0 = Monday … 6 = Sunday. Empty means every day. The day on which the window starts counts, even across midnight." }
              }
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type"],
              "properties": {
                "type": { "type": "string", "enum": ["publish", "notification"] },
                "topic": { "type": "string", "format": "mqtt-topic", "x-dataflow": {"direction": "output", "label": "Action topic"}, "x-dataflow-label-key": "dataflow.automation_rules.action_topic" },
                "retain": { "type": "boolean", "default": false },
                "payload_source": { "type": "string", "enum": ["constant", "balance", "topic", "toggle"] },
                "payload": { "type": "string" },
                "payload_on": { "type": "string" },
                "payload_off": { "type": "string" },
                "value_template": { "type": "string" },
                "field": { "type": "string", "pattern": "^(grid_export|grid_import|pv|load_total|base|wallbox|heat_pump|battery_charge|battery_discharge|gap_applied|autarkie|eigenverbrauch|battery_soc|battery_capacity_kwh|battery_energy_kwh|custom:[a-z0-9_]+)$" },
                "source_topic": { "type": "string", "format": "mqtt-topic", "x-dataflow": {"direction": "input", "label": "Value source topic", "json_key_field": "source_json_key"}, "x-dataflow-label-key": "dataflow.automation_rules.source_topic" },
                "source_json_key": { "type": "string", "format": "mqtt-json-key" },
                "scale": { "type": "number", "default": 1 },
                "offset": { "type": "number", "default": 0 },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "step": { "type": "number" },
                "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
                "entity_id": { "type": "string" },
                "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
                "title": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
