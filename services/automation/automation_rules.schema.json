                "field": { "type": "string", "pattern": "^(grid_export|grid_import|pv|load_total|base|wallbox|heat_pump|battery_charge|battery_discharge|gap_applied|autarkie|eigenverbrauch|battery_soc|battery_capacity_kwh|battery_energy_kwh|custom:[a-z0-9_]+)$" },
                "source_topic": { "type": "string", "format": "mqtt-topic", "x-dataflow": {"direction": "input", "label": "Value source topic", "json_key_field": "source_json_key"}, "x-dataflow-label-key": "dataflow.automation_rules.source_topic" },
                "source_json_key": { "type": "string", "format": "mqtt-json-key" },
