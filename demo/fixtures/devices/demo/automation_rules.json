{
  "version": 1,
  "settings": {
    "tick_interval_s": 10,
    "settling_seconds": 60,
    "balance_max_age_s": 30,
    "publish_allowed_prefixes": ["wallbox/", "waermepumpe/", "outstation/apsystems_dach/", "plug/"],
    "latitude": 48.1,
    "longitude": 11.6
  },
  "rules": [
    {
      "id": "regel_ueberschuss_wallbox",
      "name": "Überschuss in Wallbox",
      "history_enabled": true,
      "enabled": true,
      "cooldown_seconds": 60,
      "conditions": [
        {"type": "balance_threshold", "field": "grid_export", "comparison": "above", "threshold": 500, "hysteresis": 100, "hold_seconds": 30}
      ],
      "actions": [
        {"type": "publish", "topic": "wallbox/current/set", "payload_source": "constant", "payload": "16"}
      ]
    },
    {
      "id": "regel_akku_leer_wp_aus",
      "name": "Akku leer, WP aus",
      "enabled": true,
      "cooldown_seconds": 300,
      "conditions": [
        {"type": "entity_value", "entity_id": "bank_soc", "topic": "bank/soc", "comparison": "below", "value": 10, "hold_seconds": 30}
      ],
      "actions": [
        {"type": "publish", "topic": "waermepumpe/mode/set", "entity_id": "waermepumpe_mode", "payload_source": "constant", "payload": "OFF"}
      ]
    },
    {
      "id": "regel_pv_ueberschuss_wp_an",
      "name": "PV-Überschuss, WP an",
      "enabled": true,
      "cooldown_seconds": 600,
      "conditions": [
        {"type": "balance_threshold", "field": "grid_export", "comparison": "above", "threshold": 1000, "hysteresis": 200, "hold_seconds": 300}
      ],
      "actions": [
        {"type": "publish", "topic": "waermepumpe/mode/set", "entity_id": "waermepumpe_mode", "payload_source": "constant", "payload": "ON"}
      ]
    },
    {
      "id": "regel_werkstatt_last",
      "name": "Werkstatt zieht viel",
      "history_enabled": true,
      "enabled": true,
      "cooldown_seconds": 300,
      "conditions": [
        {"type": "balance_threshold", "field": "custom:werkstatt", "comparison": "above", "threshold": 1500, "hysteresis": 100, "hold_seconds": 60}
      ],
      "actions": [
        {"type": "notification", "severity": "info", "title": "Werkstatt", "message": "Die Werkstatt zieht mehr als 1,5 kW."}
      ]
    },
    {
      "id": "regel_wiederholen_wallbox",
      "name": "Wallbox nachfassen",
      "enabled": true,
      "cooldown_seconds": 60,
      "repeat_seconds": 60,
      "conditions": [
        {"type": "balance_threshold", "field": "grid_export", "comparison": "above", "threshold": 500, "hysteresis": 100, "hold_seconds": 30}
      ],
      "actions": [
        {"type": "publish", "topic": "wallbox/current/set", "payload_source": "constant", "payload": "16"}
      ]
    },
    {
      "id": "regel_balkon_gelernt_aus",
      "name": "Balkonsteckdose zur üblichen Zeit aus",
      "enabled": true,
      "cooldown_seconds": 600,
      "conditions": [
        {"type": "time_window", "weekdays": [],
         "start": {"learned": "device/plug_balkon/usual_off", "min": "21:30", "max": "23:30", "fallback": "22:30"},
         "end": {"learned": "device/plug_balkon/usual_off", "min": "21:30", "max": "23:30", "fallback": "22:30", "offset": 5}}
      ],
      "actions": [
        {"type": "publish", "topic": "plug/balkon/output/set", "payload_source": "constant", "payload": "OFF"}
      ]
    },
    {
      "id": "regel_entfeuchter_laufzeit",
      "name": "Entfeuchter nach üblicher Laufzeit aus",
      "enabled": true,
      "cooldown_seconds": 600,
      "conditions": [
        {"type": "entity_value", "entity_id": "plug_entfeuchter_steckdose", "topic": "plug/entfeuchter/output", "comparison": "equals", "text": "ON",
         "hold_seconds": {"learned": "device/plug_entfeuchter/usual_runtime_s", "min": 1200, "max": 2100, "fallback": 1800}}
      ],
      "actions": [
        {"type": "publish", "topic": "plug/entfeuchter/output/set", "payload_source": "constant", "payload": "OFF"}
      ]
    },
    {
      "id": "regel_wp_haus_ruhig",
      "name": "Wärmepumpe aus, wenn das Haus ruhig ist",
      "enabled": true,
      "cooldown_seconds": 600,
      "conditions": [
        {"type": "learned_state", "learned": "site/house_state", "equals": "quiet", "fallback": "active", "max_age_s": 7200, "hold_seconds": 1800}
      ],
      "actions": [
        {"type": "publish", "topic": "waermepumpe/mode/set", "payload_source": "constant", "payload": "OFF"}
      ]
    },
    {
      "id": "regel_wasch_ueberschuss_an",
      "name": "Waschmaschine an bei Überschuss",
      "enabled": true,
      "cooldown_seconds": 600,
      "conditions": [
        {"type": "balance_threshold", "field": "grid_export", "comparison": "above", "threshold": 1000, "hysteresis": 100, "hold_seconds": 30}
      ],
      "actions": [
        {"type": "publish", "topic": "plug/waschmaschine/output/set", "entity_id": "waschmaschine_steckdose", "payload_source": "constant", "payload": "ON"}
      ]
    },
    {
      "id": "regel_wasch_ueberschuss_aus",
      "name": "Waschmaschine aus, wenn der Überschuss fehlt",
      "enabled": true,
      "cooldown_seconds": 600,
      "conditions": [
        {"type": "balance_threshold", "field": "grid_export", "comparison": "below", "threshold": 500, "hysteresis": 100, "hold_seconds": 60}
      ],
      "actions": [
        {"type": "publish", "topic": "plug/waschmaschine/output/set", "entity_id": "waschmaschine_steckdose", "payload_source": "constant", "payload": "OFF"}
      ]
    },
    {
      "id": "regel_einspeisung_entfeuchter",
      "name": "Entfeuchter an bei viel Einspeisung",
      "enabled": true,
      "cooldown_seconds": 600,
      "conditions": [
        {"type": "balance_threshold", "field": "grid_export", "comparison": "above", "threshold": 2600, "hysteresis": 100, "hold_seconds": 60}
      ],
      "actions": [
        {"type": "publish", "topic": "plug/entfeuchter/output/set", "payload_source": "constant", "payload": "ON"}
      ]
    }
  ],
  "scenarios": [
    {
      "id": "nulleinspeisung",
      "name": "Nulleinspeisung",
      "enabled": true,
      "template": "zero_feed",
      "history_enabled": true,
      "when": { "conditions": [ { "type": "sun_window", "from": "sunrise", "to": "sunset" } ] },
      "on_start": { "actions": [ { "type": "notification", "severity": "info", "title": "Nulleinspeisung", "message": "startet" } ] },
      "while": {
        "mode": "regulate",
        "regulator": {
          "output": { "topic": "outstation/apsystems_dach/max_power_limit_w/set", "entity_id": "apsystems_dach_max_power_limit", "min": 50, "max": 800, "step": 10, "decimals": 0 },
          "direction": "producer",
          "target_w": 30,
          "deadband_w": 20,
          "gain": 0.8,
          "base": { "source": "entity", "entity_id": "apsystems_dach_total_power", "topic": "outstation/apsystems_dach/total/power_w", "value_template": "{{ value_json.power }}" },
          "fallback": { "payload": "800" }
        }
      },
      "on_end": { "actions": [ { "type": "publish", "topic": "outstation/apsystems_dach/max_power_limit_w/set", "payload_source": "constant", "payload": "800" } ] }
    }
  ]
}
