                "payload_source": "constant",
                "payload": "ON",
                "entity_id": "wb_switch"
              }
            ],
            "repeat_seconds": 60
          },
          "until": {
            "conditions": [
              {
                "type": "balance_threshold",
                "field": "grid_import",
                "comparison": "above",
                "threshold": 100,
                "hysteresis": 0,
                "hold_seconds": 120
              }
            ]
          }
        },
