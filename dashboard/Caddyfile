{
    auto_https disable_redirects
}

# Das Dashboard erzeugt root-relative URLs, solange kein Praefix-Header
# ankommt. Wer es unter /node/ ausliefert, muss X-Forwarded-Prefix setzen,
# sonst zeigt /node/ nur den 401-Text statt des Login-Screens.
# Siehe knowhow/dashboard/reverse-proxy.md.
(dashboard) {
    @not_sse {
        not path /api/v1/events
    }
    encode @not_sse zstd gzip

    redir /node /node/ 308
    handle_path /node/* {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Forwarded-Prefix /node
        }
    }
    handle {
        reverse_proxy 127.0.0.1:8080
    }
}

:80 {
    # Notfall-Hotspot (Schritt 67): Clients aus dem Hotspot-Netz bekommen
    # fuer jeden Pfad die Startseite, damit das Handy das Captive Portal erkennt.
    @hotspot remote_ip 10.42.0.0/24
    handle @hotspot {
        header Cache-Control no-store
        rewrite * /index.html
        root * /usr/share/energy-node/hotspot
        file_server
    }
    import dashboard
}

:443 {
    tls internal {
        on_demand
    }
    import dashboard
}