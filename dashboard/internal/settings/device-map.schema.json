{
  "title": "Device-Map positions and relation overrides",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nodes"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "device_id": {"type": "string", "minLength": 1},
          "virtual_id": {"type": "string", "minLength": 1},
          "x": {"type": "number"},
          "y": {"type": "number"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "child_id", "parent_id", "kind", "created_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "child_id": {"type": "string", "minLength": 1},
          "parent_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "created_at": {"type": "string"}
        }
      }
    },
    "edge_props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent_id", "child_id", "type"],
        "properties": {
          "parent_id": {"type": "string", "minLength": 1},
          "child_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["energy", "data", "info"]},
          "direction": {"type": "string", "enum": ["auto", "reversed", "fixed_down", "fixed_up"]}
        }
      }
    },
    "switch_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "device_id", "function"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "device_id": {"type": "string", "minLength": 1},
          "function": {"type": "string", "enum": ["output", "none"]}
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snap_to_grid": {"type": "boolean"},
        "show_grid": {"type": "boolean"},
        "grid_size": {"type": "integer", "minimum": 4, "maximum": 400},
        "edge_style": {"type": "string", "enum": ["straight", "elbow", "curved"]},
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wiring", "energy", "balance", "data"],
          "properties": {
            "wiring": {"type": "boolean"},
            "energy": {"type": "boolean"},
            "balance": {"type": "boolean"},
            "data": {"type": "boolean"}
          }
        },
        "width_by_power": {"type": "boolean"},
        "hide_automation_links": {"type": "boolean"}
      }
    }
  }
}
