{
  "title": "Energy role assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignments"],
  "properties": {
    "assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role"],
        "properties": {
          "role": {"type": "string"},
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1
          },
          "invert": {
            "type": "boolean",
            "default": false
          },
          "capacity_kwh": {
            "type": "number",
            "minimum": 0,
            "default": 0
          }
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "base", "color", "icon"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "base": {"type": "string", "enum": ["consumer", "producer", "storage"]},
          "color": {"type": "string", "enum": ["cat_1", "cat_2", "cat_3", "cat_4", "cat_5", "cat_6"]},
          "icon": {"type": "string", "minLength": 1}
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "members"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "members": {
            "type": "object",
            "additionalProperties": false,
            "required": ["devices", "groups"],
            "properties": {
              "devices": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "groups": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "role": {"type": "string"}
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gap_mode": {
          "type": "string",
          "enum": ["unknown_consumer", "diagnostic"]
        },
        "load_mode": {
          "type": "string",
          "enum": ["measured", "calculated", "auto", "combined"]
        },
        "gap_tolerance_mode": {
          "type": "string",
          "enum": ["absolute", "percent"]
        },
        "gap_tolerance_w": {
          "type": "number",
          "minimum": 0
        },
        "gap_tolerance_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "surplus_threshold_w": {
          "type": "number",
          "minimum": 0
        },
        "import_threshold_w": {
          "type": "number",
          "minimum": 0
        },
        "battery_reserve_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
