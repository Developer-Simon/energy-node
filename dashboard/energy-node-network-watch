#!/bin/sh
# energy-node-network-watch: keeps the WLAN fallback and the emergency hotspot
# in line with the LAN. Runs every 15 s from energy-node-network-watch.timer.
#
# Settings come from /etc/energy-node/network.json: fallback "parallel" (the
# default) or "standby", hotspot true (the default) or false. The state is kept
# as epoch timestamps under /run/energy-node/network-watch/.
#
# Before the emergency hotspot opens, the watcher scans for Wi-Fi networks and
# keeps the list in wifi-scan, its time in wifi-scan-at (epoch seconds).
#
# Test hooks: NOW (epoch seconds, default date +%s), NETWORK_JSON, STATE_DIR,
# SYSFS (default /sys), NM_CONF_DIR (default /etc/NetworkManager/conf.d) and
# SCAN_WAIT_S (seconds to wait after the scan, default 5). nmcli, ip, iw,
# systemctl and python3 are looked up on PATH, so a test can stub them.
set -u

NETWORK_JSON="${NETWORK_JSON:-/etc/energy-node/network.json}"
STATE_DIR="${STATE_DIR:-/run/energy-node/network-watch}"
SYSFS="${SYSFS:-/sys}"
NM_CONF_DIR="${NM_CONF_DIR:-/etc/NetworkManager/conf.d}"
MAC_CONF="$NM_CONF_DIR/90-energy-node-wifi-mac.conf"
MAC_MARKER='# von energy-node verwaltet - Aenderungen gehen verloren'
WLAN_DEV=wlan0
LAN_DEV=eth0
HOTSPOT=energy-node-hotspot
SWITCH_UNIT=energy-node-wifi-switch.service
LAN_GRACE_S=30
HOTSPOT_AFTER_S=300
CONNECT_WAIT_S=60
SCAN_WAIT_S="${SCAN_WAIT_S:-5}"

# While the helper runs a WLAN switch, the watcher leaves the network alone.
if systemctl is-active --quiet "$SWITCH_UNIT"; then
  exit 0
fi

# Without NetworkManager there is nothing to steer.
if ! command -v nmcli >/dev/null 2>&1; then
  exit 0
fi

now="${NOW:-$(date +%s)}"
mkdir -p "$STATE_DIR" || exit 0

settings="$(python3 -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        doc = json.load(f)
except (OSError, ValueError):
    doc = {}
if not isinstance(doc, dict):
    doc = {}
fallback = doc.get("fallback")
if fallback not in ("parallel", "standby"):
    fallback = "parallel"
hotspot = "false" if doc.get("hotspot") is False else "true"
print(fallback, hotspot)
' "$NETWORK_JSON" 2>/dev/null)" || settings="parallel true"
fallback="${settings% *}"
hotspot="${settings#* }"

lan_up=no
if [ "$(cat "$SYSFS/class/net/$LAN_DEV/carrier" 2>/dev/null)" = 1 ] &&
  ip -4 -o addr show dev "$LAN_DEV" 2>/dev/null | grep -q inet; then
  lan_up=yes
fi

wlan_dev=no
if [ -e "$SYSFS/class/net/$WLAN_DEV/wireless" ]; then
  wlan_dev=yes
fi

wlan_up=no
if nmcli -t -f DEVICE,STATE device 2>/dev/null | grep -qx "$WLAN_DEV:connected"; then
  wlan_up=yes
fi

hotspot_active=no
if nmcli -t -f NAME connection show --active 2>/dev/null | grep -qx "$HOTSPOT"; then
  hotspot_active=yes
fi

# since NAME prints the seconds since the timestamp NAME was set. It fails when
# the timestamp is missing or broken.
since() {
  value="$(cat "$STATE_DIR/$1" 2>/dev/null)"
  case "$value" in
    ''|*[!0-9]*) return 1 ;;
  esac
  echo $((now - value))
}

# stamp_start NAME sets the timestamp to now, unless it is already there.
stamp_start() {
  if ! since "$1" >/dev/null; then
    echo "$now" > "$STATE_DIR/$1"
  fi
}

stamp_clear() {
  rm -f "$STATE_DIR/$1"
}

hotspot_down() {
  nmcli connection down id "$HOTSPOT" >/dev/null 2>&1 || true
}

# save_scan asks for a fresh Wi-Fi scan and keeps the list. An empty scan changes
# nothing, and an unchanged list is not written again.
save_scan() {
  nmcli device wifi rescan >/dev/null 2>&1 || true
  sleep "$SCAN_WAIT_S"
  scan="$(nmcli -t -f IN-USE,SSID,SIGNAL,FREQ,CHAN,SECURITY device wifi list --rescan no 2>/dev/null || true)"
  if [ -z "$scan" ]; then
    return 0
  fi
  printf '%s\n' "$scan" > "$STATE_DIR/wifi-scan.new"
  if ! cmp -s "$STATE_DIR/wifi-scan.new" "$STATE_DIR/wifi-scan"; then
    mv "$STATE_DIR/wifi-scan.new" "$STATE_DIR/wifi-scan"
    echo "$now" > "$STATE_DIR/wifi-scan-at"
  fi
  rm -f "$STATE_DIR/wifi-scan.new"
}

hotspot_up() {
  save_scan
  nmcli connection up id "$HOTSPOT" >/dev/null 2>&1 || true
  echo "$now" > "$STATE_DIR/hotspot_since"
}

wlan_connected() {
  nmcli -t -f DEVICE,STATE device 2>/dev/null | grep -qx "$WLAN_DEV:connected"
}

# connect_client [wait_seconds] brings up the first saved WLAN client profile
# that works. The AP profile of the emergency hotspot is skipped, so a connect
# never starts the hotspot early. Returns 1 when no client profile connects.
connect_client() {
  wait_s="${1:-}"
  # A for loop, not a pipe into while: the loop must run in this shell.
  for line in $(nmcli -t -f UUID,TYPE connection show 2>/dev/null); do
    case "$line" in
      *:802-11-wireless) ;;
      *) continue ;;
    esac
    uuid="${line%%:*}"
    mode="$(nmcli -g 802-11-wireless.mode connection show uuid "$uuid" 2>/dev/null)"
    if [ "$mode" = ap ]; then
      continue
    fi
    if [ -n "$wait_s" ]; then
      nmcli --wait "$wait_s" connection up uuid "$uuid" >/dev/null 2>&1 && return 0
    else
      nmcli connection up uuid "$uuid" >/dev/null 2>&1 && return 0
    fi
  done
  return 1
}

# mac_conf_sync writes the NetworkManager drop-in that gives wlan0 the eth0 MAC
# while the cable is unplugged in standby mode, and removes it again otherwise.
# A file without the marker is never touched.
mac_conf_sync() {
  want=no
  carrier="$(cat "$SYSFS/class/net/$LAN_DEV/carrier" 2>/dev/null)"
  mac="$(tr 'A-F' 'a-f' 2>/dev/null < "$SYSFS/class/net/$LAN_DEV/address")"
  if [ "$fallback" = standby ] && [ "$wlan_dev" = yes ] && [ "$carrier" != 1 ] &&
    printf '%s\n' "$mac" | grep -Eq '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'; then
    want=yes
  fi
  has_marker=no
  if head -n 1 "$MAC_CONF" 2>/dev/null | grep -qxF "$MAC_MARKER"; then
    has_marker=yes
  fi
  if [ "$want" = yes ]; then
    if [ -e "$MAC_CONF" ] && [ "$has_marker" = no ]; then
      return 0
    fi
    # The trailing x keeps the final newline through command substitution.
    content="$(printf '%s\n[connection-energy-node-wifi-mac]\nmatch-device=interface-name:wlan0\nwifi.cloned-mac-address=%s\n' \
      "$MAC_MARKER" "$mac"; printf x)"
    content="${content%x}"
    # Nothing is written when the file already has the wanted content.
    if [ -f "$MAC_CONF" ] && printf '%s' "$content" | cmp -s - "$MAC_CONF"; then
      return 0
    fi
    tmp="$(mktemp "$NM_CONF_DIR/.wifi-mac.XXXXXX" 2>/dev/null)" || return 0
    printf '%s' "$content" > "$tmp"
    chmod 0644 "$tmp"
    if mv -f "$tmp" "$MAC_CONF"; then
      nmcli general reload conf >/dev/null 2>&1 || true
    fi
    rm -f "$tmp"
  elif [ "$has_marker" = yes ]; then
    rm -f "$MAC_CONF"
    nmcli general reload conf >/dev/null 2>&1 || true
  fi
  return 0
}

# clone_rebuild_check rebuilds the WLAN link once when wlan0 still carries the
# eth0 MAC from the standby clone. Parallel mode only.
clone_rebuild_check() {
  [ "$wlan_up" = yes ] || return 0
  mac_eth="$(tr 'A-F' 'a-f' 2>/dev/null < "$SYSFS/class/net/$LAN_DEV/address")"
  mac_wlan="$(tr 'A-F' 'a-f' 2>/dev/null < "$SYSFS/class/net/$WLAN_DEV/address")"
  if [ -n "$mac_eth" ] && [ "$mac_eth" = "$mac_wlan" ]; then
    nmcli device disconnect "$WLAN_DEV" >/dev/null 2>&1 || true
    connect_client || true
  fi
  return 0
}

mac_conf_sync

# WLAN as a replacement for a lost LAN, or always on in parallel mode.
if [ "$fallback" = standby ]; then
  if [ "$lan_up" = yes ]; then
    stamp_clear lan_lost_at
    if [ "$wlan_dev" = yes ]; then
      nmcli device set "$WLAN_DEV" autoconnect no >/dev/null 2>&1 || true
      nmcli device disconnect "$WLAN_DEV" >/dev/null 2>&1 || true
    fi
  else
    stamp_start lan_lost_at
    lost="$(since lan_lost_at)"
    if [ "$lost" -ge "$LAN_GRACE_S" ] && [ "$wlan_dev" = yes ]; then
      nmcli device set "$WLAN_DEV" autoconnect yes >/dev/null 2>&1 || true
      # Only when not yet connected: nmcli re-activates a connected device,
      # which would drop the WLAN on every run.
      if [ "$wlan_up" = no ]; then
        connect_client || true
      fi
    fi
  fi
else
  stamp_clear lan_lost_at
  if [ "$wlan_dev" = yes ]; then
    nmcli device set "$WLAN_DEV" autoconnect yes >/dev/null 2>&1 || true
  fi
  clone_rebuild_check
fi

# Emergency hotspot. offline_since counts the time without LAN and without WLAN.
if [ "$lan_up" = yes ] || [ "$wlan_up" = yes ]; then
  stamp_clear offline_since
else
  stamp_start offline_since
fi

if [ "$hotspot_active" = yes ]; then
  if [ "$lan_up" = yes ] || [ "$hotspot" = false ]; then
    hotspot_down
    stamp_clear hotspot_since
  else
    stamp_start hotspot_since
    # Without a readable station list the state is unknown: leave the hotspot alone.
    if clients_out="$(iw dev "$WLAN_DEV" station dump 2>/dev/null)"; then
      clients="$(printf '%s\n' "$clients_out" | grep -c '^Station')"
      opened="$(since hotspot_since)"
      if [ "$clients" -eq 0 ] && [ "$opened" -ge "$HOTSPOT_AFTER_S" ]; then
        # Nobody is connected: try the saved WLAN networks once more.
        hotspot_down
        connect_client "$CONNECT_WAIT_S" || true
        if wlan_connected; then
          stamp_clear hotspot_since
        else
          hotspot_up
        fi
      fi
    fi
  fi
else
  if [ "$hotspot" = true ] && [ "$wlan_dev" = yes ] && [ "$lan_up" = no ] && [ "$wlan_up" = no ]; then
    offline="$(since offline_since)"
    retry=yes
    last="$(since hotspot_since)" && [ "$last" -lt "$HOTSPOT_AFTER_S" ] && retry=no
    if [ "$offline" -ge "$HOTSPOT_AFTER_S" ] && [ "$retry" = yes ]; then
      hotspot_up
    fi
  fi
fi

exit 0
