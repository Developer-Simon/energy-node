# The single place the public mirror repo's identifiers live.
# scripts/publish_mirror.sh reads these to rewrite
# custom_components/energy_node_companion/manifest.json for the mirror (OWNER/REPO
# substituted into manifest.overrides.json). Public values only, no secrets.
OWNER=Developer-Simon
REPO=ha-energy-node-companion
HA_MIN_VERSION=2024.12.0
MIRROR_PATH=/home/simon/dev/ha-energy-node-companion
CHANGELOG_TARGET=ha-energy-node-companion
CHANGELOG_PATH=integrations/homeassistant/custom_components/energy_node_companion/CHANGELOG.md
RELEASE_NAME="Energy Node Companion"
