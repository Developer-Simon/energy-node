# The single place the public mirror repo's identifiers live.
# scripts/publish_mirror.sh reads these to rewrite
# custom_components/energy_node_icons/manifest.json for the mirror (OWNER/REPO
# substituted into manifest.overrides.json). Public values only, no secrets.
OWNER=Developer-Simon
REPO=ha-energy-node-icons
HA_MIN_VERSION=2024.12.0
MIRROR_PATH=/home/simon/dev/ha-energy-node-icons
CHANGELOG_TARGET=ha-icons
CHANGELOG_PATH=integrations/homeassistant/custom_components/energy_node_icons/CHANGELOG.md
DOCS_IMG=
RELEASE_NAME="energy-node Icons integration"
ICON_CHECK=1
