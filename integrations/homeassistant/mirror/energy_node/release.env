# The single place the public mirror repo's identifiers live.
# scripts/publish_mirror.sh reads these to rewrite
# custom_components/energy_node/manifest.json for the mirror (OWNER/REPO
# substituted into manifest.overrides.json). Public values only, no secrets.
OWNER=Developer-Simon
REPO=ha-energy-node
HA_MIN_VERSION=2024.12.0
MIRROR_PATH=/home/simon/dev/ha-energy-node
CHANGELOG_TARGET=ha-energy-node
CHANGELOG_PATH=integrations/homeassistant/custom_components/energy_node/CHANGELOG.md
DOCS_IMG=
RELEASE_NAME="energy-node Home Assistant integration"
