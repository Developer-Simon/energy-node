# The single place the public mirror repo's identifiers live.
# scripts/publish_mirror.sh reads these to rewrite
# custom_components/battery_soc/manifest.json for the mirror (OWNER/REPO
# substituted into manifest.overrides.json). Public values only, no secrets.
OWNER=Developer-Simon
REPO=ha-battery-soc
HA_MIN_VERSION=2024.12.0
MIRROR_PATH=/home/simon/dev/ha-battery-soc
CHANGELOG_TARGET=ha-integration
CHANGELOG_PATH=integrations/homeassistant/CHANGELOG.md
DOCS_IMG=integrations/homeassistant/docs/img
RELEASE_NAME="Battery SoC Home Assistant integration"
# Shared field descriptions: strings carry [%schema:...%] placeholders that
# publish_mirror.sh renders from this schema (scripts/render_ha_descriptions.py).
SCHEMA_DESCRIPTIONS=services/battery_soc/battery_soc_devices.schema.json
