if loadfont $prefix/font.pf2 ; then
  set gfxmode=800x600
  set gfxpayload=keep
  insmod efi_gop
{{- if .Amd64}}
  insmod efi_uga
  insmod video_bochs
  insmod video_cirrus
{{- end}}
  insmod gfxterm
  insmod png
  terminal_output gfxterm
fi
set default=0
set timeout=10
set timeout_style=menu
menuentry 'Energy Node: Debian installieren (loescht die interne Platte)' {
    linux    /{{.BootDir}}/vmlinuz auto=true priority=critical locale={{.Locale}} keymap={{.Keyboard}} file=/cdrom/preseed.cfg --- quiet
    initrd   /{{.BootDir}}/initrd.gz
}
menuentry 'Debian-Installer ohne Automatik' {
    linux    /{{.BootDir}}/vmlinuz --- quiet
    initrd   /{{.BootDir}}/initrd.gz
}
