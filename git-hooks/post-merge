#!/usr/bin/env bash
#
# After merging a branch into main, deletes that branch's pre-release tags
# (<major>.<minor>.<patch>-<branch>.<build>, created by post-commit while
# committing on the branch) since main only tracks the plain patch-bumped
# version.
#
# Handles both regular merges and squash merges by deleting all orphaned
# pre-release tags (tags that don't point to any commit on the current branch).
#
# Not tracked by git itself - installed into .git/hooks/ via
# scripts/install_git_hooks.sh.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"
source "${repo_root}/git-hooks/lib.sh"

if [[ "$(current_branch)" != "main" ]]; then
  exit 0
fi

# Try regular merge first (works for regular and fast-forward merges)
reflog_entry="$(git reflog show -1 HEAD)"
if [[ "${reflog_entry}" =~ :\ merge\ ([^:]+):\  ]]; then
  merged_branch="${BASH_REMATCH[1]}"
  safe_branch="$(sanitize_branch "${merged_branch}")"
  while IFS= read -r tag; do
    [[ -z "${tag}" ]] && continue
    git tag -d "${tag}" >/dev/null
    echo "post-merge: Pre-Release-Tag ${tag} entfernt (Branch ${merged_branch} gemerged)"
  done < <(git tag -l "*-${safe_branch}.*")
  exit 0
fi

# Fallback for squash merges: delete all orphaned pre-release tags
# (tags not reachable from main that match the pre-release pattern)
while IFS= read -r tag; do
  [[ -z "${tag}" ]] && continue
  if ! git merge-base --is-ancestor "${tag}" HEAD 2>/dev/null; then
    git tag -d "${tag}" >/dev/null
    echo "post-merge: Verwaistes Pre-Release-Tag ${tag} entfernt (squash merge)"
  fi
done < <(git tag -l "*-*.*")
