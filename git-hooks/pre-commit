#!/usr/bin/env bash
#
# Drift guards for three generated artefacts that must be regenerated by
# script, never hand-edited: the battery_soc_core copy in the Home Assistant
# integration, the battery-card-core.js copy in the Lovelace card, and
# dashboard/internal/appconfig/config.schema.json (composed by
# dashboard/cmd/schemagen from core.schema.json + services/*/config.schema.json).
# Runs on every branch.
#
# Per-component version bumping is NOT done here anymore. `main` is
# PR-protected, so the working tree never commits there and the old main-only
# bump could never fire. The bump the squash-merge used to carry is now applied
# on the PR branch by .github/workflows/version-bump.yml
# (scripts/version/bump-patch.sh). post-commit / post-merge still handle the
# local pre-release tags on feature branches.
#
# Not tracked by git itself - installed into .git/hooks/ via
# scripts/install_git_hooks.sh.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

# --- Vendored-core drift guard ----------------------------------------------
# The Home Assistant integration ships a copy of libs/battery_soc_core. It is a
# derived artifact: regenerate it with scripts/vendor_core.py, never by hand.
if printf '%s\n' "${staged_files}" | grep -qE '^(libs/battery_soc_core/|integrations/homeassistant/custom_components/battery_soc/battery_soc_core/)'; then
  if ! python3 "${repo_root}/scripts/vendor_core.py" --check; then
    echo "pre-commit: vendored core is out of sync." >&2
    echo "pre-commit: run  .venv/bin/python scripts/vendor_core.py  and stage the result." >&2
    exit 1
  fi
fi

# --- Vendored-card drift guard --------------------------------------------
# The Lovelace card ships a vendored copy of battery-card-core.js.
# It is a derived artifact: regenerate it with scripts/vendor_card.py, never by hand.
if ! python3 "${repo_root}/scripts/vendor_card.py" --check; then
  echo "pre-commit: vendored card core is out of sync." >&2
  echo "pre-commit: run  .venv/bin/python scripts/vendor_card.py  and stage the result." >&2
  exit 1
fi

# --- Generated config-schema drift guard --------------------------------
# dashboard/internal/appconfig/config.schema.json is composed by
# dashboard/cmd/schemagen from core.schema.json + services/*/config.schema.json.
# Regenerate it with  (cd dashboard && go run ./cmd/schemagen)  — never by hand.
# Needs the Go toolchain on PATH; the guard only fires when a schema, manifest
# or fragment file is staged.
if printf '%s\n' "${staged_files}" \
  | grep -qE '^(dashboard/cmd/schemagen/|dashboard/internal/appconfig/config\.schema\.json$|services/[^/]+/(manifest|config\.schema)\.json$)'; then
  if ! ( cd "${repo_root}/dashboard" && go run ./cmd/schemagen -check ); then
    echo "pre-commit: generated config schema is out of sync with the service fragments." >&2
    echo "pre-commit: run  (cd dashboard && go run ./cmd/schemagen)  and stage the result." >&2
    exit 1
  fi
fi
